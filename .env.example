# Copy this file to .env and fill in your real key. Never commit .env.
#
# Get a free Gemini API key at https://aistudio.google.com/apikey
# (sign in with a Google account, click "Create API key" — no payment needed
# for the free tier).
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides:
# PORT=8787
# GEMINI_MODEL=gemini-3.6-flash
